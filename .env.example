# Rusty WebGME + webgme-git configuration
# Copy to .env and fill in your GitHub App credentials for live GitHub sync.

PORT=8888
MONGO_URI=mongodb://127.0.0.1:27017/rusty_webgme
WEBGME_BASE_URL=http://127.0.0.1:8888

# Deployment / UI routing options:
# - Dev default (`npm start` or `npm run start:dev`): both Rusty Studio (`/routers/studio`)
#   and WebGME Generic UI (`/`) are enabled with guest access unless `RUSTY_AUTH=true`.
# - Production (`npm run start:prod` / `NODE_ENV=prod`): enforces GitHub OAuth authentication
#   (`/profile/login` + `/logout`), disables the generic WebGME UI, and serves Rusty Studio at `/`.
# RUSTY_STUDIO_ONLY=true
# RUSTY_SERVE_WEBGME_UI=true
# RUSTY_ROOT_TO_STUDIO=false

# Set RUSTY_AUTH=true to enforce GitHub App OAuth + webgme-git /profile pages.
# When omitted or false (default in dev), WebGME runs with guest access so you can
# explore modeling, codegen, and simulation immediately before configuring a GitHub App.
RUSTY_AUTH=false

# GitHub App settings (required when RUSTY_AUTH=true or when syncing with GitHub)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Optional: comma-separated GitHub logins auto-promoted to siteAdmin on first login
BOOTSTRAP_ADMIN_LOGINS=
