# Rusty WebGME + webgme-git configuration
# Copy to .env and fill in the sections you need.

PORT=8888
MONGO_URI=mongodb://127.0.0.1:27017/rusty_webgme
WEBGME_BASE_URL=http://127.0.0.1:8888

# ---------------------------------------------------------------------------
# Deployment / UI routing options
# ---------------------------------------------------------------------------
# - Dev default (`npm start` or `npm run start:dev`): both Rusty Studio (`/routers/studio`)
#   and WebGME Generic UI (`/`) are enabled with guest access unless `RUSTY_AUTH=true`.
# - Production (`npm run start:prod` / `NODE_ENV=prod`): enforces Layer 1 authentication
#   (`/profile/login` + `/logout`), disables the generic WebGME UI, and serves Rusty Studio at `/`.
# RUSTY_STUDIO_ONLY=true
# RUSTY_SERVE_WEBGME_UI=true
# RUSTY_ROOT_TO_STUDIO=false

# ---------------------------------------------------------------------------
# Layer 1 — WebGME User Authentication (webgme-engine)
# ---------------------------------------------------------------------------
# Set RUSTY_AUTH=true (or use NODE_ENV=prod / OAUTH_*) to require sign-in.
RUSTY_AUTH=false

# Optional external OAuth 2.0 / OIDC login for WebGME users
# Built-in presets: OAUTH_PROVIDER=github | google (or any custom name + OAUTH_DISCOVERY_URL)
# Callback URL in your external IdP / OAuth App: ${WEBGME_BASE_URL}/oauth/callback
# OAUTH_PROVIDER=github
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=
# OAUTH_DISCOVERY_URL=
# OAUTH_AUTHORIZATION_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=
# OAUTH_SCOPES=
# OAUTH_USE_PKCE=true
# OAUTH_USER_ID_PREFIX=

# Optional Layer 1 controls (when omitted, password login is auto-disabled if OAuth is active)
# RUSTY_ALLOW_PASSWORD_LOGIN=
# RUSTY_ENABLE_ACCESS_TOKENS=true

# ---------------------------------------------------------------------------
# Layer 2 — GitHub App Repository Sync (webgme-git)
# ---------------------------------------------------------------------------
# Attached 1-to-1 to authenticated WebGME users at /profile#account -> /profile/github/connect.
# Set the GitHub App "User authorization callback URL" to:
#   ${WEBGME_BASE_URL}/profile/github/callback
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
